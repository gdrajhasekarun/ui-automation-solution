# Target app — full internal base URL (e.g. http://10.0.1.50:8080/myapp/)
APP_URL=

# App credentials
APP_USERNAME=
APP_PASSWORD=

# CSS selector for any element that ONLY appears after successful login
# Right-click a post-login element → Inspect → copy its id or name as a selector
# Examples: #dashboard   .user-menu   [name='j_idt_header']
APP_SUCCESS_INDICATOR=

# Firecrawl (optional — enhances crawl if set)
FIRECRAWL_API_KEY=

# Anthropic (Planner Service)
ANTHROPIC_API_KEY=

# Service URLs (defaults work if all on localhost)
DASHBOARD_URL=http://localhost:8000
CRAWL_URL=http://localhost:8001
GENERATOR_URL=http://localhost:8002
PLANNER_URL=http://localhost:8003
EXECUTOR_URL=http://localhost:8004

# Shared paths
SHARED_DIR=./shared
JAVA_DIR=./shared/java

# Browser configuration for Playwright (Phase 2)
# If 'playwright install' is blocked, point at a manually downloaded browser:
#   PLAYWRIGHT_CHROMIUM_PATH=C:\path\to\chrome.exe   (Windows)
#   PLAYWRIGHT_CHROMIUM_PATH=/path/to/chrome          (Mac/Linux)
# Alternatively, use an installed system browser channel:
#   PLAYWRIGHT_CHANNEL=chrome
#   PLAYWRIGHT_CHANNEL=msedge
# Crawl4AI (Phase 1) honors PLAYWRIGHT_BROWSERS_PATH for its own browser cache.
PLAYWRIGHT_CHROMIUM_PATH=
PLAYWRIGHT_CHANNEL=
