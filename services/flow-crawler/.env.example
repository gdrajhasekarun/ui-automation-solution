# flow-crawler service port
FLOW_CRAWLER_PORT=8006

# LLM provider: anthropic | openai | gemini | ollama | azure
LLM_PROVIDER=openai

# API keys — only the one matching LLM_PROVIDER needs to be set
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Azure OpenAI (if LLM_PROVIDER=azure)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# Ollama (if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Headless browser (set to 'false' to see the browser)
CRAWL_HEADLESS=true

# Output directory (relative to service root — matches crawl-ai default)
OUTPUT_DIR=../../shared/outputs
