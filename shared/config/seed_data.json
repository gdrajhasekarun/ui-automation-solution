{
  "appId": "client-app",
  "appUrl": "${APP_URL}",
  "auth": {
    "strategy": "form",
    "loginUrl": "/login",
    "fields": {
      "[name='j_username']": "${APP_USERNAME}",
      "[name='j_password']": "${APP_PASSWORD}"
    },
    "submitSelector": "input[type='submit']",
    "successIndicator": "${APP_SUCCESS_INDICATOR}"
  },
  "blocklist": [
    "/logout",
    "/delete",
    "/destroy",
    "/admin/reset",
    "/j_spring_security_logout"
  ],
  "shared_element_threshold": 0.70,
  "max_pages": 60,
  "max_depth": 3
}
